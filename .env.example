# SecureAgentOps configuration. Copy to .env (`make env` does this and generates random secrets).
# Every value here is a placeholder. Never commit a real .env file.

# --- Runtime -------------------------------------------------------------------------
SAO_ENVIRONMENT=development          # development | test | production
SAO_LOG_LEVEL=INFO

# --- Authentication ------------------------------------------------------------------
# 32+ random characters. Required in production. If unset in development, an ephemeral
# secret is generated per process (tokens stop working on restart).
SAO_JWT_SECRET=replace-with-at-least-32-random-characters
SAO_ACCESS_TOKEN_MINUTES=60
SAO_ALLOW_SELF_REGISTRATION=true

# --- Demo data (refused when SAO_ENVIRONMENT=production) ---------------------------------
SAO_SEED_DEMO_DATA=true
# Password for the four demo accounts. If empty, one is generated and written to
# data/demo-credentials.txt (owner-readable only).
SAO_DEMO_PASSWORD=replace-with-a-demo-password-123

# --- LLM -------------------------------------------------------------------------------
# mock    = deterministic, offline, free (default)
# bedrock = Amazon Bedrock Converse API; uses the standard AWS credential chain
SAO_LLM_PROVIDER=mock
SAO_AWS_REGION=us-east-1
# Example: amazon.nova-lite-v1:0 (must be enabled in your AWS account and region)
SAO_BEDROCK_MODEL_ID=
SAO_LLM_TIMEOUT_SECONDS=30
SAO_LLM_MAX_OUTPUT_TOKENS=600
# Optional USD prices per 1K tokens; cost is only estimated when both are set (never in mock mode).
SAO_PRICE_INPUT_PER_1K_TOKENS=
SAO_PRICE_OUTPUT_PER_1K_TOKENS=

# Do NOT put AWS keys here. Use an AWS profile, SSO, or an IAM role.

# --- Retrieval --------------------------------------------------------------------------
SAO_EMBEDDING_PROVIDER=hash          # hash (offline, deterministic) | bedrock (Titan v2)
SAO_EMBEDDING_DIM=384                # Titan v2 supports 256, 512 or 1024
SAO_CHUNK_SIZE=800
SAO_CHUNK_OVERLAP=120
SAO_RETRIEVAL_TOP_K=4
SAO_RETRIEVAL_MIN_SCORE=0.08
SAO_MAX_UPLOAD_MB=5

# --- Agent and abuse protection ---------------------------------------------------------
SAO_TOOL_TIMEOUT_SECONDS=5
SAO_APPROVAL_TTL_HOURS=24
SAO_REQUIRE_DISTINCT_APPROVER=true
SAO_RATE_LIMIT_PER_MINUTE=30
SAO_LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Observability ----------------------------------------------------------------------
# OTLP/HTTP collector base URL, e.g. http://otel-collector:4318 (traces go to /v1/traces)
SAO_OTEL_EXPORTER_OTLP_ENDPOINT=
SAO_OTEL_CONSOLE_EXPORT=false

# --- Dashboard ----------------------------------------------------------------------------
SAO_API_URL=http://localhost:8000
